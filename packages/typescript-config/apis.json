{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "APIS",
  "compilerOptions": {
    "target": "es2017",
    "moduleResolution": "node",
    "module": "commonjs",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "./dist",
    "lib": ["esnext", "DOM"],
    "strictPropertyInitialization": false
  },
}
