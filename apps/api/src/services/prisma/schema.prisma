generator client {
  provider = "prisma-client-js"
  output   = "../src/services/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrderItems {
  id           String @id @default(uuid())
  itemName     String
  itemQuantity Int
  unitPrice    Int
  totalPrice   Int
  orderId      String
  order        Orders @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SENT
  DELIVERED
  CANCELLED
}

model Orders {
  id String @id @default(uuid())

  // clientId String | Esperando o modelo de users

  customerName String

  customerPhone String

  items OrderItems[]

  totalAmount Int

  status OrderStatus @default(PENDING)

  createdAt DateTime @default(now())

  updatedAt DateTime @default(now())

  deletedAt DateTime?
}
