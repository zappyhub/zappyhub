// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../src/services/prisma"
}

datasource db {
  provider = "postgresql"
}

model OrderItems {
  id           String @id @default(uuid())
  itemName     String
  itemQuantity Int
  unitPrice    Int
  totalPrice   Int
  orderId      String
  order        Orders @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Company {
  id                   String    @id @default(uuid())
  name                 String
  companyName          String    @unique
  companyLegalRegister String
  email                String?   @unique
  cellphoneNumber      String?   @unique
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?
  user                 User?     @relation(fields: [userId], references: [id])
  userId               String?

  @@index([email])
  @@index([cellphoneNumber])
  @@index([companyName])
  @@index([active])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SENT
  DELIVERED
  CANCELLED
}

model User {
  id                      String    @id @default(uuid())
  userName                String    @unique
  email                   String?   @unique
  cellphoneNumber         String?   @unique
  active                  Boolean   @default(true)
  emailVerified           Boolean   @default(false)
  cellphoneNumberVerified Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now())
  deletedAt               DateTime?
  passwordHash            String

  companiesOwned Company[]
  orders         Orders[]
  refreshTokens  RefreshToken[]

  @@index([email])
  @@index([cellphoneNumber])
  @@index([userName])
  @@index([active])
}

model Orders {
  id            String       @id @default(uuid())
  customerName  String
  customerPhone String
  items         OrderItems[]
  totalAmount   Int
  status        OrderStatus  @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  deletedAt     DateTime?
  user          User?        @relation(fields: [userId], references: [id])
  userId        String?
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  User User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
