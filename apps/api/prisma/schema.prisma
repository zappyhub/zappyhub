// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/services/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model OrderItems {
  id           String @id @default(uuid())
  itemName     String
  itemQuantity Int
  unitPrice    Int
  totalPrice   Int
  orderId      String
  order        Orders @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model Company {
  id                   String    @id @default(uuid())
  name                 String
  companyName          String    @unique
  companyLegalRegister String
  email                String?   @unique
  cellphoneNumber      String?   @unique
  active               Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  @@index([email])
  @@index([cellphoneNumber])
  @@index([companyName])
  @@index([active])
}

enum OrderStatus {
  PENDING
  CONFIRMED
  IN_PROGRESS
  SENT
  DELIVERED
  CANCELLED
}

model Orders {
  id            String       @id @default(uuid())
  clientId      String
  client        User        @relation(fields: [clientId], references: [id])
  customerName  String
  customerPhone String
  items         OrderItems[]
  totalAmount   Int
  status        OrderStatus  @default(PENDING)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @default(now())
  deletedAt     DateTime?
}

model User {
  id              String   @id @default(uuid())
  name            String
  userName        String   @unique
  email           String   @unique
  cellphoneNumber String   @unique
  passwordHash    String
  role            Role     @default(USER)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  deletedAt       DateTime?

  // relação com Orders
  orders Orders[]
}

enum Role {
  ADMIN
  USER
}

